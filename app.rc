#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"
IDI_WORLD_CLOCK ICON "world-clock.ico"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "World Clock Native C++"
      VALUE "FileVersion", "2.0.0"
      VALUE "ProductName", "World Clock"
      VALUE "ProductVersion", "2.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
IDD_SETTINGS DIALOGEX 0,0,310,335
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "卡片设置"
FONT 9,"Microsoft YaHei UI"
BEGIN
 CONTROL "始终置顶",IDC_TOP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,12,120,14
 CONTROL "自绘磨砂背景",IDC_GLASS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,147,12,150,14
 LTEXT "外观模式：",-1,12,37,70,12
 COMBOBOX IDC_THEME,86,34,210,90,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 CONTROL "使用自定义卡片颜色",IDC_CUSTOM,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,59,170,14
 PUSHBUTTON "选择颜色…",IDC_COLOR,214,57,82,20
 LTEXT "背景浓度（0 = 透出桌面，100 = 不透明）：",-1,12,85,280,13
 CONTROL "",IDC_ALPHA,TRACKBAR_CLASS,WS_TABSTOP | TBS_AUTOTICKS,12,105,226,24
 EDITTEXT IDC_ALPHA_NUMBER,250,107,44,16,ES_NUMBER | ES_RIGHT | WS_TABSTOP
 LTEXT "0 去除背景及磨砂；大于 0 启用磨砂，文字清晰。",-1,12,134,286,13
 GROUPBOX "显示内容",-1,10,156,288,93
 CONTROL "城市",IDC_SHOW_CITY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,171,76,14
 CONTROL "地区 / 国家",IDC_SHOW_REGION,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,112,171,84,14
 CONTROL "日期",IDC_SHOW_DATE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,214,171,70,14
 CONTROL "星期",IDC_SHOW_WEEKDAY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,192,76,14
 CONTROL "时差",IDC_SHOW_OFFSET,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,112,192,84,14
 CONTROL "天气",IDC_SHOW_WEATHER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,214,192,70,14
 CONTROL "秒",IDC_SHOW_SECONDS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,213,76,14
 CONTROL "太阳 / 月亮",IDC_SHOW_SUN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,112,213,90,14
 CONTROL "日出 / 日落",IDC_SHOW_SUNTIMES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,214,213,78,14
 LTEXT "应用范围：",-1,12,258,66,13
 COMBOBOX IDC_SYNC,82,254,215,110,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "点击确定后同步外观和显示项；保留各城市及位置。",-1,12,281,287,13
 DEFPUSHBUTTON "确定",IDOK,139,307,75,20
 PUSHBUTTON "取消",IDCANCEL,224,307,75,20
END
IDD_CITY DIALOGEX 0,0,390,270
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "联网添加城市"
FONT 9,"Microsoft YaHei UI"
BEGIN
 LTEXT "输入中文、英文或拼音；选择结果时请核对地区。",-1,12,10,366,13
 EDITTEXT IDC_QUERY,12,29,288,21,ES_AUTOHSCROLL | WS_TABSTOP
 PUSHBUTTON "搜索",IDC_SEARCH,309,29,68,21
 LTEXT "常用城市（无需联网搜索）",IDC_STATUS,12,59,365,15
 LISTBOX IDC_RESULTS,12,78,365,140,LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | WS_BORDER | LBS_NOINTEGRALHEIGHT
 LTEXT "城市：GeoNames / Open-Meteo",-1,12,226,230,13
 DEFPUSHBUTTON "添加",IDOK,216,246,75,20
 PUSHBUTTON "取消",IDCANCEL,302,246,75,20
END
